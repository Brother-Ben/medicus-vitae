{
	"name": "medicus-vitae",
	"description": "Medicus Vitae: personal MCAT study app. Read your books, make cards, review with FSRS, track mistakes and progress.",
	"private": true,
	"version": "0.7.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Brother-Ben/medicus-vitae"
	},
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"predev": "node scripts/copy-assets.mjs",
		"dev": "vite dev",
		"prebuild": "node scripts/copy-assets.mjs",
		"build": "vite build",
		"build:next": "node scripts/build-next.mjs",
		"package": "node scripts/package.mjs",
		"package:check": "node scripts/smoke-test.mjs",
		"start": "node server/index.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:e2e": "node tests/e2e/run.mjs",
		"db:generate": "drizzle-kit generate",
		"sample-pdf": "node tests/fixtures/make-sample-pdf.mjs",
		"desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/build.ps1",
		"desktop:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/make-icons.ps1"
	},
	"devDependencies": {
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24",
		"@types/yauzl": "^3.4.0",
		"@types/yazl": "^3.3.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"marked": "^18.1.2",
		"playwright-core": "^1.64.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.3.0",
		"@huggingface/transformers": "^4.3.2",
		"argon2": "^0.45.1",
		"better-sqlite3": "^13.0.2",
		"htmlparser2": "^12.0.0",
		"katex": "^0.19.1",
		"pdfjs-dist": "^6.4.299",
		"sqlite-vec": "0.1.9",
		"ts-fsrs": "^5.4.2",
		"yauzl": "^3.4.0",
		"yazl": "^3.3.1"
	}
}
