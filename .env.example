# Medicus Vitae settings. Copy to .env next to this file and change what you need.
# Every setting is optional. (They keep the CORTEX_ names from before the app was
# renamed, so existing .env files keep working.)

# Port the web app listens on.
PORT=8080

# Address to listen on. 127.0.0.1 = this computer only (use `tailscale serve` to
# reach it from your phone). 0.0.0.0 = every network (Windows will ask about the
# firewall). Docker images use 0.0.0.0 inside the container.
HOST=127.0.0.1

# Where your data lives (database, books, snapshots). Relative to this folder.
CORTEX_DATA_DIR=data

# Show the Quit button in the web app (off in Docker, where the restart policy would restart it).
CORTEX_ALLOW_QUIT=true

# Hourly and daily snapshots (recommended).
CORTEX_SNAPSHOTS=true

# How often a standby asks its primary for a newer snapshot, in minutes.
CORTEX_PEER_POLL_MINUTES=5

# ---- AI tutor (optional; also settable in Settings > AI) -------------------
# API keys used when none is saved in Settings > AI. Keys saved in Settings go to
# the standby with snapshots, but never into exports.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Meaning search and the tutor's index use a small local embedding model
# (Xenova/bge-small-en-v1.5, about 34 MB), downloaded once from Hugging Face into
# the models folder. Set to off to use keyword search only.
CORTEX_EMBEDDINGS=on
# Where the model is kept (default: data/models). Put the model files here ahead
# of time and set CORTEX_MODEL_DOWNLOAD=off for a machine without internet.
# CORTEX_MODELS_DIR=data/models
# CORTEX_MODEL_DOWNLOAD=on
